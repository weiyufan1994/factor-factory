FROM node:24-bookworm-slim

ARG OPENCLAW_VERSION=2026.7.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 python3-pip procps \
    && npm install --global "openclaw@${OPENCLAW_VERSION}" \
    && python3 -m pip install --break-system-packages --no-cache-dir \
       boto3 duckdb numpy pandas polars pyarrow pyqlib s3fs scikit-learn scipy statsmodels \
    && apt-get clean

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ENTRYPOINT []
