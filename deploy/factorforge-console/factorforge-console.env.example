FACTORFORGE_CONSOLE_INVITE_PASSWORD=replace-via-secrets-manager
FACTORFORGE_CONSOLE_COOKIE_SECRET=replace-with-random-secret
FACTORFORGE_CONSOLE_COOKIE_SECURE=1
FACTORFORGE_CONSOLE_OPENCLAW_PROFILE=factorforge-console
FACTORFORGE_CONSOLE_MODEL=deepseek/deepseek-reasoner
FACTORFORGE_CONSOLE_THINKING=high
FACTORFORGE_CONSOLE_OPENCLAW_AUTH_PROVIDER=deepseek
FACTORFORGE_CONSOLE_OPENCLAW_AUTH_SEED_DB=/var/lib/factorforge-console/credential-seed/openclaw-agent.sqlite
FACTORFORGE_CONSOLE_EXECUTION_MODE=container
FACTORFORGE_CONSOLE_CONTAINER_RUNTIME=docker
FACTORFORGE_CONSOLE_CONTAINER_NETWORK=factorforge-console-egress
FACTORFORGE_CONSOLE_CONTAINER_NETWORK_SUBNET=172.29.0.0/24
FACTORFORGE_CONSOLE_CONTAINER_PROXY_URL=http://172.29.0.1:3128
FACTORFORGE_CONSOLE_MODEL_BROKER_URL=http://172.29.0.1:8781
FACTORFORGE_CONSOLE_AWS_READONLY_ROLE_NAME=factorforge-console-pilot-data-read-role
FACTORFORGE_CONSOLE_INSTALLATION_ID=factorforge-console-pilot-20260801
FACTORFORGE_CONSOLE_ENGINE_COMMIT=replace-with-pinned-commit
FACTORFORGE_CONSOLE_AGENT_IMAGE=sha256:replace-with-built-image-id
FACTORFORGE_CONSOLE_OPENCLAW_PROFILE_TEMPLATE=/srv/factorforge/control/deploy/factorforge-console/openclaw.json.example
FACTORFORGE_CONSOLE_STATE_ROOT=/var/lib/factorforge-console/state
FACTORFORGE_CONSOLE_WORKTREE_ROOT=/var/lib/factorforge-console/runs
FACTORFORGE_DATA_CATALOGS=/var/lib/factorforge-console/data-api-runtime/catalogs/data_catalog.json
FACTORFORGE_CONSOLE_CATALOG_RECEIPT=/var/lib/factorforge-console/data-api-runtime/catalogs/data_catalog.receipt.json
FACTORFORGE_DATA_API_PYTHONPATH=/srv/factorforge/data-api
