FACTORFORGE_CONSOLE_INVITE_PASSWORD=replace-via-secrets-manager
FACTORFORGE_CONSOLE_COOKIE_SECRET=replace-with-random-secret
FACTORFORGE_CONSOLE_COOKIE_SECURE=1
FACTORFORGE_CONSOLE_OPENCLAW_PROFILE=factorforge-console
FACTORFORGE_CONSOLE_MODEL=deepseek/deepseek-reasoner
FACTORFORGE_CONSOLE_THINKING=high
FACTORFORGE_CONSOLE_OPENCLAW_AUTH_PROVIDER=deepseek
FACTORFORGE_CONSOLE_OPENCLAW_AUTH_SEED_DB=/var/lib/factorforge-console/credential-seed/openclaw-agent.sqlite
FACTORFORGE_CONSOLE_STATE_ROOT=/var/lib/factorforge-console/state
FACTORFORGE_CONSOLE_WORKTREE_ROOT=/var/lib/factorforge-console/runs
FACTORFORGE_DATA_CATALOGS=/srv/factorforge/data-api-runtime/catalogs/manus_data_catalog.json
FACTORFORGE_DATA_API_PYTHONPATH=/srv/factorforge/data-api
