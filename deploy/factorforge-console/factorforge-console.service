[Unit]
Description=Factor Forge invitation research Console
After=network-online.target docker.service factorforge-console-network.service
Wants=network-online.target
Requires=docker.service factorforge-console-network.service

[Service]
Type=simple
User=factorforge
Group=factorforge
SupplementaryGroups=docker
WorkingDirectory=/srv/factorforge/control
Environment=HOME=/var/lib/factorforge-console
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/factorforge-console/console.env
ExecStartPre=/usr/bin/mkdir -p /var/lib/factorforge-console/data-api-runtime/catalogs
ExecStartPre=/usr/bin/aws s3 cp s3://yufan-data-lake/factorforge/data/catalog/data_catalog.json /var/lib/factorforge-console/data-api-runtime/catalogs/data_catalog.json --region ap-southeast-1 --only-show-errors
ExecStart=/usr/bin/python3 scripts/run_factorforge_console.py --source-repo /srv/factorforge/control --state-root /var/lib/factorforge-console/state --worktree-root /var/lib/factorforge-console/runs --base-ref HEAD --catalog /var/lib/factorforge-console/data-api-runtime/catalogs/data_catalog.json --data-api-pythonpath /srv/factorforge/data-api --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/factorforge-console /srv/factorforge/control/.git

[Install]
WantedBy=multi-user.target
