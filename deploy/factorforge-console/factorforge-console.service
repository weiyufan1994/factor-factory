[Unit]
Description=Factor Forge invitation research Console web
After=network-online.target factorforge-console-runner.service
Wants=network-online.target
Requires=factorforge-console-runner.service

[Service]
Type=simple
User=factorforge-web
Group=factorforge-console
WorkingDirectory=/srv/factorforge/control
Environment=HOME=/var/lib/factorforge-console/web-home
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/factorforge-console/console.env
ExecStart=/usr/bin/python3 scripts/run_factorforge_console.py --mode web --source-repo /srv/factorforge/control --state-root /var/lib/factorforge-console/state --worktree-root /var/lib/factorforge-console/runs --base-ref HEAD --catalog /var/lib/factorforge-console/data-api-runtime/catalogs/data_catalog.json --data-api-pythonpath /srv/factorforge/data-api --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/factorforge-console/state

[Install]
WantedBy=multi-user.target
