{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAnyS3UseOutsideDedicatedEndpoint",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::yufan-data-lake",
        "arn:aws:s3:::yufan-data-lake/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:SourceVpce": "__S3_VPCE_ID__"
        }
      }
    },
    {
      "Sid": "DenyMutationEvenIfAnotherPolicyIsAttached",
      "Effect": "Deny",
      "NotAction": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::yufan-data-lake",
        "arn:aws:s3:::yufan-data-lake/*"
      ]
    },
    {
      "Sid": "ListOnlyApprovedPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::yufan-data-lake",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "factorforge/*",
            "tushares/*"
          ]
        },
        "StringEquals": {
          "aws:SourceVpce": "__S3_VPCE_ID__"
        }
      }
    },
    {
      "Sid": "ReadOnlyApprovedObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::yufan-data-lake/factorforge/*",
        "arn:aws:s3:::yufan-data-lake/tushares/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:SourceVpce": "__S3_VPCE_ID__"
        }
      }
    }
  ]
}
