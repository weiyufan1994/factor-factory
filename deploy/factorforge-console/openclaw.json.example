{
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "http://172.29.0.1:8781",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "api": "openai-completions",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 1000000,
            "maxTokens": 384000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/var/lib/factorforge-console/openclaw-workspace",
      "skills": [],
      "skipBootstrap": true,
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": []
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "params": {"maxTokens": 16384}
        }
      },
      "maxConcurrent": 1,
      "subagents": {
        "maxConcurrent": 1,
        "archiveAfterMinutes": 60
      },
      "heartbeat": {
        "every": "0m",
        "target": "none"
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 16384,
        "reserveTokensFloor": 12000,
        "keepRecentTokens": 12000,
        "recentTurnsPreserve": 1,
        "maxHistoryShare": 0.5,
        "identifierPolicy": "strict",
        "qualityGuard": {"enabled": true, "maxRetries": 1},
        "midTurnPrecheck": {"enabled": true},
        "postIndexSync": "off",
        "postCompactionSections": [],
        "truncateAfterCompaction": true,
        "maxActiveTranscriptBytes": "2mb",
        "notifyUser": false,
        "memoryFlush": {"enabled": false}
      }
    }
  },
  "plugins": {
    "allow": []
  },
  "tools": {
    "allow": ["read", "edit", "write", "apply_patch", "exec", "process"],
    "fs": {"workspaceOnly": true},
    "exec": {
      "host": "gateway",
      "mode": "full",
      "strictInlineEval": false,
      "applyPatch": {"workspaceOnly": true}
    },
    "sessions": {"visibility": "self"},
    "elevated": {"enabled": false},
    "agentToAgent": {"enabled": false}
  }
}
