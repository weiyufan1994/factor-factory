{
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "http://172.29.0.1:8781",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-reasoner",
            "name": "DeepSeek Reasoner",
            "api": "openai-completions",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 65536
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/var/lib/factorforge-console/openclaw-workspace",
      "skills": [],
      "skipBootstrap": true,
      "model": {
        "primary": "deepseek/deepseek-reasoner",
        "fallbacks": []
      },
      "models": {
        "deepseek/deepseek-reasoner": {}
      },
      "maxConcurrent": 1,
      "subagents": {
        "maxConcurrent": 1,
        "archiveAfterMinutes": 60
      },
      "heartbeat": {
        "every": "0m",
        "target": "none"
      }
    }
  },
  "plugins": {
    "allow": []
  },
  "tools": {
    "allow": ["read", "edit", "write", "apply_patch", "exec", "process"],
    "fs": {"workspaceOnly": true},
    "exec": {
      "host": "gateway",
      "mode": "full",
      "strictInlineEval": false,
      "applyPatch": {"workspaceOnly": true}
    },
    "sessions": {"visibility": "self"},
    "elevated": {"enabled": false},
    "agentToAgent": {"enabled": false}
  }
}
